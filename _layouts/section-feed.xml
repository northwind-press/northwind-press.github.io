---
---
{%- comment -%}
  Atom feed for one section (pages in feeds/). Front matter: section, subsection (slug or none),
  permalink. Last 20 posts, newest first. Site-wide /feed.xml is jekyll-feed's and is separate.
{%- endcomment -%}
{%- include section-posts.html section=page.section subsection=page.subsection -%}
{%- assign feed_posts = section_posts | slice: 0, 20 -%}
{%- assign newest = feed_posts | first -%}
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom" xml:lang="{{ site.lang | default: 'en' }}">
  <title>{{ site.title | xml_escape }}: {{ section_name | xml_escape }}</title>
  <subtitle>{{ site.description | xml_escape }}</subtitle>
  <link href="{{ page.url | absolute_url }}" rel="self" type="application/atom+xml"/>
  <link href="{{ section_url | absolute_url }}" rel="alternate" type="text/html"/>
  <id>{{ page.url | absolute_url | xml_escape }}</id>
  <updated>{% if newest %}{{ newest.last_modified_at | default: newest.date | date_to_xmlschema }}{% else %}{{ site.time | date_to_xmlschema }}{% endif %}</updated>
  <author><name>{{ site.title | xml_escape }}</name></author>
  {%- for post in feed_posts %}
  {%- assign entry_kind = site.data.kinds | where: 'slug', post.kind | first %}
  <entry>
    <title type="html">{{ post.title | smartify | xml_escape }}</title>
    <link href="{{ post.url | absolute_url }}" rel="alternate" type="text/html"/>
    <id>{{ post.url | absolute_url | xml_escape }}</id>
    <published>{{ post.date | date_to_xmlschema }}</published>
    <updated>{{ post.last_modified_at | default: post.date | date_to_xmlschema }}</updated>
    <author><name>{{ post.author | default: site.title | xml_escape }}</name></author>
    {%- if entry_kind %}
    <category term="{{ entry_kind.slug }}" label="{{ entry_kind.label | xml_escape }}"/>
    {%- endif %}
    {%- if post.description %}
    <summary type="html">{{ post.description | smartify | xml_escape }}</summary>
    {%- endif %}
    <content type="html" xml:base="{{ post.url | absolute_url }}">{{ post.content | xml_escape }}</content>
  </entry>
  {%- endfor %}
</feed>
